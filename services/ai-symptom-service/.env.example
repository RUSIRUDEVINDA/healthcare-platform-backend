PORT=8008
APP_ENV=development
AUTH_SERVICE_URL=http://localhost:8001

# Chat history (PostgreSQL). Required for persisting checks. Docker Compose sets this automatically.
# DATABASE_URL=postgres://postgres:password123@localhost:5432/symptom_db?sslmode=disable

# LLM: openai | gemini
AI_PROVIDER=openai
